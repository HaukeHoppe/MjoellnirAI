# Copy to .env and fill in. docker compose reads .env automatically.
OPENAI_API_KEY=sk-...

# Key for both Pipelines servers. Use the same value for the pipelines connections
# in Open WebUI (Admin Panel -> Settings -> Connections). Generate with: openssl rand -hex 32
PIPELINES_API_KEY=

# Signs Open WebUI login sessions. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Public address of the instance, e.g. https://chat.example.com (defaults to http://localhost:3000)
# On the VPS, Caddy serves exactly this address and fetches its HTTPS certificate.
WEBUI_URL=

# Browser address(es) allowed to use the API and chat websocket, e.g. https://chat.example.com
# (exactly as in the address bar: no trailing slash; several separated by ';'). Defaults to http://localhost:3000.
# A mismatch breaks the chat, so on a VPS set it to the same address as WEBUI_URL.
CORS_ALLOW_ORIGIN=

# VPS only: "vps" also starts the Caddy HTTPS reverse proxy (ports 80/443). Leave empty locally.
COMPOSE_PROFILES=

# VPS only: contact email for the HTTPS certificates. Also enables Caddy's ZeroSSL fallback when
# Let's Encrypt is rate-limited (common on shared hoster hostnames like v123.luckysrv.de).
ACME_EMAIL=

# VPS only: no login screen. Set WEBUI_AUTH_TRUSTED_EMAIL_HEADER=X-Webui-Email; Caddy then signs every
# visitor in as GUEST_EMAIL (create that account first, role "user") and the SSH-tunnel admin port
# 127.0.0.1:8081 as ADMIN_EMAIL (your existing admin account). Leave all three empty locally.
# Also add http://localhost:8081 to CORS_ALLOW_ORIGIN (separated by ';') for the admin entrance.
WEBUI_AUTH_TRUSTED_EMAIL_HEADER=
GUEST_EMAIL=
ADMIN_EMAIL=

# Graph explorer (localhost:3001, VPS: /graph/): where its "Im Chat fragen" button and legal links point.
# Defaults to http://localhost:3000/. On the VPS set it to / (Caddy serves chat and explorer on one site).
GRAPH_CHAT_URL=

# VPS only: "journald" sends container logs to the systemd journal, which deletes them after 14 days
# (see README, privacy policy). Leave empty locally (Docker default json-file).
LOG_DRIVER=
