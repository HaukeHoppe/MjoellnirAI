# Copy to .env and fill in. docker compose reads .env automatically.
OPENAI_API_KEY=sk-...

# Key for both Pipelines servers. Use the same value for the pipelines connections
# in Open WebUI (Admin Panel -> Settings -> Connections). Generate with: openssl rand -hex 32
PIPELINES_API_KEY=

# Signs Open WebUI login sessions. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Public address of the instance, e.g. https://chat.example.com (defaults to http://localhost:3000)
# On the VPS, Caddy serves exactly this address and fetches its HTTPS certificate.
WEBUI_URL=

# VPS only: "vps" also starts the Caddy HTTPS reverse proxy (ports 80/443). Leave empty locally.
COMPOSE_PROFILES=

# VPS only: contact email for the HTTPS certificates. Also enables Caddy's ZeroSSL fallback when
# Let's Encrypt is rate-limited (common on shared hoster hostnames like v123.luckysrv.de).
ACME_EMAIL=
