# HTTPS entry point for Open WebUI on a VPS (compose profile "vps").
# The site address is WEBUI_URL from .env, e.g. https://chat.example.com. Caddy obtains and
# renews a certificate for that domain automatically and redirects HTTP to HTTPS.
# Requirements: the domain's DNS A/AAAA record points at the VPS, ports 80 and 443 are open.

{
	# replace (plugin, see Dockerfile.caddy) runs after encode, so it sees the uncompressed page.
	order replace after encode

	# With an email set, Caddy falls back from Let's Encrypt to ZeroSSL when Let's Encrypt
	# refuses (e.g. its 50-certificates-per-domain limit on shared hoster domains).
	email {$ACME_EMAIL}
}

{$WEBUI_URL} {
	encode zstd gzip

	# Private instance: keep it out of search engines. Open WebUI's robots.txt already
	# disallows crawling; this header also covers bots that skip robots.txt.
	header X-Robots-Tag "noindex, nofollow, noarchive"

	# Browser hardening: HTTPS only for a year (HSTS), no MIME sniffing, no framing by other
	# sites (clickjacking), no full URLs leaked to other sites. No CSP: Open WebUI loads inline
	# scripts and styles that a strict policy would break.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Public site: no password prompt in front of it; visitors are signed in as the guest account (below).

	# Legal pages from ./legal (/impressum -> impressum.html), outside Open WebUI; linked from a banner in the chat.
	@legal path /impressum /datenschutz /lizenzen
	handle @legal {
		root * /etc/caddy/legal
		rewrite * {path}.html
		file_server
	}

	# Graph explorer (graph-explorer container): a static page, no Open WebUI login involved.
	redir /graph /graph/
	handle_path /graph/* {
		reverse_proxy graph-explorer:8080
	}

	# The guest account is shared by all visitors: nobody may rename it, change its picture or password.
	@guest_account path /api/v1/auths/update/profile /api/v1/auths/update/password
	respond @guest_account "Not available for the guest account" 403

	# Open WebUI loads /static/custom.css on every page; visitors get guest.css instead, which hides the
	# user menu (settings, sign out) and the "You're now logged in" toast.
	# no-cache: browsers revalidate it on every load, so a cached older custom.css never wins.
	handle /static/custom.css {
		header Cache-Control "no-cache"
		root * /etc/caddy
		rewrite * /guest.css
		file_server
	}

	# Legal footer on every Open WebUI page: Open WebUI shows its banner only on the empty start screen, but
	# Impressum and Datenschutz must stay reachable during a chat too. Only page loads (Sec-Fetch-Dest:
	# document) are rewritten, never API or streaming responses. Accept-Encoding is dropped so Open WebUI
	# sends the page uncompressed for the replacement; Caddy's encode compresses it for the browser.
	@page {
		header Sec-Fetch-Dest document
		not path /impressum /datenschutz /lizenzen /graph /graph/*
	}
	handle @page {
		replace "</body>" `<div id="legal-footer" style="position:fixed;right:10px;bottom:4px;z-index:9999;font:11px/1.4 system-ui,sans-serif;color:#8b8b8b"><a href="/impressum" data-sveltekit-reload style="color:inherit;text-decoration:none">Impressum</a> · <a href="/datenschutz" data-sveltekit-reload style="color:inherit;text-decoration:none">Datenschutz</a> · <a href="/lizenzen" data-sveltekit-reload style="color:inherit;text-decoration:none">Lizenzen</a></div></body>`
		reverse_proxy open-webui:8080 {
			header_up X-Webui-Email {$GUEST_EMAIL}
			header_up -Accept-Encoding
		}
	}

	# No login for visitors: every request is signed in as the shared guest account (role "user",
	# no admin rights). header_up overwrites any value the client sends, so it cannot be forged.
	# Chat streaming (SSE) and websockets are proxied without extra config.
	reverse_proxy open-webui:8080 {
		header_up X-Webui-Email {$GUEST_EMAIL}
	}
}

# Admin entrance: published on 127.0.0.1:8081 of the VPS only (see docker-compose.yaml), so it is
# reachable only through an SSH tunnel: ssh -L 8081:127.0.0.1:8081 <vps>, then http://localhost:8081
http://:8081 {
	reverse_proxy open-webui:8080 {
		header_up X-Webui-Email {$ADMIN_EMAIL}
	}
}
